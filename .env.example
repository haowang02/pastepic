# Host address and port the container is published on.
# Keep it private (loopback or the Docker bridge) and serve it through a reverse proxy with HTTPS.
PASTEPIC_BIND=127.0.0.1:8080

# Public origin used in generated image links. Leave empty to derive it from each request.
PUBLIC_URL=https://img.example.com

# Days before an image is deleted.
RETENTION_DAYS=7

# Maximum size of a single image, in MB. Your reverse proxy must accept bodies at least this large.
MAX_UPLOAD_MB=25

# Uploads allowed per client IP every 10 minutes.
UPLOAD_RATE_MAX=120

# Number of reverse proxies in front of the app. Use 0 if clients connect to it directly.
TRUST_PROXY=1
